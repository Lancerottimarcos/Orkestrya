# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite database
/prisma/*.db
/prisma/*.db-journal

# uploaded media (attachments) - not committed, persists on the server
/public/uploads/*
!/public/uploads/.gitkeep

# local tooling artifacts (not needed to run the app)
/.claude
/.windsurf
/.agents
skills-lock.json
